# Development Dockerfile for Vue.js frontend
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm install

# Copy source code
COPY . .

# Expose port 8081 (matches vue.config.js)
EXPOSE 8081

# Start development server
CMD ["npm", "run", "serve"]
